# --- Supabase (bắt buộc để chạy dữ liệu thật) ---
# Chỉ dùng publishable/anon key. KHÔNG BAO GIỜ đặt service-role key ở đây.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Tuỳ chọn ---
# Tên trường hiển thị ở màn hình đăng nhập
VITE_SCHOOL_NAME=
# Trang trung tính mà nút "Thoát nhanh" chuyển tới
VITE_QUICK_EXIT_URL=https://www.google.com
# Cho phép đăng nhập bằng mã tài khoản (vd. hs2026001) -> hs2026001@<domain>
VITE_ACCOUNT_EMAIL_DOMAIN=school.example
# Chỉ khi chạy dev với Supabase local đã seed: hiện danh sách tài khoản demo ở trang đăng nhập
VITE_SHOW_DEMO_ACCOUNTS=false
